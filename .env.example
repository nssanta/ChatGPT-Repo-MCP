# chatrepo-mcp configuration
#
# Copy this file to `.env` and edit it, or export the same variables in your
# process/service manager. Every value below is read by
# both `python/src/chatrepo_mcp/config.py` and `go/internal/config/config.go`.
# The shared acceptance suite prevents those implementations from drifting.
# Uncommented lines here show the server's REAL default, so you can
# leave most of them alone and only change what you need.
#
# Recommended safe starting point for a fresh install:
#   ACCESS_MODE=safe             (the default below)
#   DENIED_WORDS=sudo,su          (already the default below)
#   For a public URL, add a ChatGPT-supported auth layer. For OpenAI Secure
#   MCP Tunnel, keep this server on loopback and put the runtime API key only
#   in tunnel-client (MCP_AUTH_MODE=none is appropriate there).

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Friendly server name, shown in a few places (has no security meaning).
APP_NAME=chatrepo-mcp

# REQUIRED. Absolute path to the folder this server may operate on -- the
# "workspace root". This can be a single git repository, or a parent folder
# containing several independent repositories (a "polyrepo" workspace; see
# the `list_repos` tool). The agent can freely move into any sub-folder but
# never above this root (unless you open it up below). No default: the
# server refuses to start without it.
PROJECT_ROOT=/path/to/your/workspace

# Bind address and port for the HTTP server.
HOST=127.0.0.1
PORT=8000

# MCP transport. streamable-http is what ChatGPT's remote-MCP connector uses.
TRANSPORT=streamable-http

# -----------------------------------------------------------------------------
# Access mode
# -----------------------------------------------------------------------------

# safe (default): scoped filesystem, allowlisted shell, dry-run writes, stale
# hash protection, and explicit confirmation for risky structural actions.
# full: trusted-machine coding-agent mode. It enables unrestricted shell and
# filesystem access, real writes by default, move/delete, and removes internal
# confirmation gates. ChatGPT's own 4-level action-permission setting remains
# independent; select "Allow all actions" in the ChatGPT UI if you do not want
# the client to ask before tool calls.
ACCESS_MODE=safe

# Full mode does not automatically expose secret-looking paths through the
# structured filesystem/edit/index tools. Set this true only if those tools
# must read or edit .env/keys/.git internals. An unrestricted shell in full
# mode is intentionally raw and can access anything permitted to the OS user.
ALLOW_SECRET_ACCESS=false

# Separate high-risk structural interlock. Raw unrestricted shell can still
# invoke git reset --hard; this flag controls the dedicated git_reset tool.
ALLOW_HARD_RESET=false

# -----------------------------------------------------------------------------
# Workspace / perimeter (where the agent is allowed to look at all)
# -----------------------------------------------------------------------------

# Extra absolute paths to allow in addition to PROJECT_ROOT, comma-separated.
# Useful for a shared library that lives outside the main workspace folder.
# Empty by default (only PROJECT_ROOT is in scope).
WORKSPACE_ROOTS=

# DANGER: when true, removes the workspace perimeter entirely -- structured tools
# can read/write/run anywhere on the machine's filesystem the process user
# can reach (PROJECT_ROOT/WORKSPACE_ROOTS are ignored). SECRET_GLOBS still
# blocks secret-looking paths unless ACCESS_MODE=full and
# ALLOW_SECRET_ACCESS=true. Off by default; only enable this on a
# machine you fully trust for this purpose.
FILESYSTEM_UNRESTRICTED=false

# How many directory levels deep `list_repos` / `doctor` scan a non-git
# PROJECT_ROOT looking for nested git repositories (polyrepo discovery).
WORKSPACE_SCAN_DEPTH=2

# -----------------------------------------------------------------------------
# Command policy (run_command / run_commands / run_test_preset / jobs)
# -----------------------------------------------------------------------------

# One of:
#   allowlist    - strictest: only a small built-in list of safe commands
#                  (plus whatever you add via .chatrepo/mcp.yml) is allowed;
#                  shell operators (&&, |, ;, ...) are rejected outright.
#   guarded      - full bash is available, but any
#                  command matching DESTRUCTIVE_WORDS requires the caller to
#                  pass confirmed=true, and DENIED_WORDS is always blocked.
#   unrestricted - no command-policy checks. ACCESS_MODE=full forces this.
# Raw git push is blocked in safe mode and routed through git_push. Full mode
# deliberately permits raw shell, including git push.
COMMAND_POLICY_MODE=allowlist

# Executables/tokens that are always rejected as the first word of a command
# segment, in every mode except unrestricted. Comma-separated.
DENIED_WORDS=sudo,su

# Command prefixes that guarded mode treats as destructive and gates behind
# confirmed=true (ignored in unrestricted mode). Comma-separated; entries may
# be multi-word prefixes.
DESTRUCTIVE_WORDS=rm -rf,rmdir,git push --force,git reset --hard,git clean,docker system prune,chmod -R,chown -R,mkfs,dd

# Optional shell snippet prepended before every run_command/run_test_preset
# invocation (e.g. to source nvm, pyenv, or a virtualenv). Empty by default;
# `bash -lc` already sources your normal login shell profile, so most stacks
# need nothing here. Example: 'source ~/.nvm/nvm.sh && nvm use 22'
COMMAND_SHELL_PRELUDE=

# Extra executable directories, separated with the OS PATH separator. They
# take priority over inherited PATH; missing directories are ignored.
MCP_EXTRA_PATH=

# Hard cap on how long a single command may run, in milliseconds.
COMMAND_TIMEOUT_MS=300000

# Where structured JSON audit records for every run_command/job/git-push are
# appended (one JSON object per line, secrets redacted).
COMMAND_AUDIT_LOG_PATH=~/.local/state/chatrepo-mcp/commands.log

# Directory used to track background command jobs (start_command_job /
# get_command_job).
COMMAND_JOBS_DIR=/tmp/chatrepo-mcp-jobs

# Process-group shutdown and persistent terminal controls.
KILL_GRACE_MS=5000
# PTY tools are registered only with ACCESS_MODE=full on Linux/macOS.
ENABLE_PTY=false
MAX_TERMINAL_SESSIONS=4

# -----------------------------------------------------------------------------
# Git
# -----------------------------------------------------------------------------

# Timeout (seconds) for network git operations: fetch/pull/push.
GIT_NETWORK_TIMEOUT=60

# Branches that require confirmed=true for git_push in safe mode. Full mode
# treats confirmation as granted. Comma-separated.
PROTECTED_BRANCHES=main,master

# When false (default), git_push's force_with_lease option is rejected even
# with confirmed=true. Set true to allow force-with-lease in the structured
# git_push tool; safe mode also requires confirmation, full mode does not.
ALLOW_FORCE_PUSH=false

# -----------------------------------------------------------------------------
# GitHub (gh CLI-backed PR/CI tools)
# -----------------------------------------------------------------------------

# Timeout (seconds) for `gh` CLI calls (PR/issue/CI tools).
GH_TIMEOUT=60

# Registers the gh_* tools at all. If `gh` is not installed or not
# authenticated, each tool call reports a graceful `gh_unavailable` error
# with an install hint instead of failing the server startup.
GITHUB_TOOLS_ENABLED=true

# -----------------------------------------------------------------------------
# Security / limits
# -----------------------------------------------------------------------------

# Secret-looking patterns blocked by structured filesystem/edit/index tools.
# Exposure requires ACCESS_MODE=full plus ALLOW_SECRET_ACCESS=true. This does
# not sandbox the unrestricted raw shell available in full mode.
SECRET_GLOBS=.env,.env.*,*.pem,*.key,*.p12,*.pfx,**/.git/**

# Glob patterns treated as binary/non-text content: blocked from the
# text-oriented read/search/edit tools (but not from run_command).
BINARY_GLOBS=**/.venv/**,**/node_modules/**,**/*.db,**/*.sqlite,**/*.sqlite3,**/*.bin,**/*.png,**/*.jpg,**/*.jpeg,**/*.webp,**/*.pdf,**/*.zip,**/*.tar,**/*.gz

# Combined block-list applied by the general filesystem tools (list_dir,
# read_text_file, search_text, find_files, ...); superset of
# SECRET_GLOBS + BINARY_GLOBS plus a couple of noisy directories.
BLOCKED_GLOBS=.env,.env.*,*.pem,*.key,*.p12,*.pfx,**/.git/**,**/.venv/**,**/node_modules/**,**/*.db,**/*.sqlite,**/*.sqlite3,**/*.bin,**/*.png,**/*.jpg,**/*.jpeg,**/*.webp,**/*.pdf,**/*.zip,**/*.tar,**/*.gz

# Glob patterns that write tools are allowed to touch. **/* means "every
# path" but is deliberately inert by itself -- see
# DANGEROUSLY_ALLOW_ALL_WRITES below.
WRITABLE_GLOBS=**/*

# Interlock: WRITABLE_GLOBS entries that mean "everything" ("*", "**/*") are
# ignored (writes rejected) unless this is explicitly true. This exists so a
# copy-pasted "allow everything" glob can't silently disable the write
# perimeter -- you must opt in on purpose. Secret policy is evaluated separately.
DANGEROUSLY_ALLOW_ALL_WRITES=false

# When true, write tools require the caller to pass the current file's
# expected_sha256 (as returned by read tools), rejecting the write if the
# file changed since it was last read (stale-write protection).
REQUIRE_EXPECTED_HASH_FOR_WRITES=true

# When true, move_path/delete_path/batch "move"/"delete_file" operations are
# available at all; false disables them regardless of glob policy.
ALLOW_MOVE_DELETE_OPERATIONS=false

# Read limits
MAX_FILE_BYTES=5000000
MAX_RESPONSE_CHARS=1000000
MAX_READ_FILES=25
MAX_SEARCH_RESULTS=500
MAX_TREE_ENTRIES=5000
MAX_DIFF_BYTES=1000000
MAX_LOG_COMMITS=100

# Write/edit limits
MAX_WRITE_FILE_BYTES=1000000
MAX_BATCH_OPERATIONS=50
MAX_COMBINED_DIFF_CHARS=300000
MAX_PATCH_BYTES=500000

# Command output limit (characters of combined stdout+stderr kept/returned).
MAX_COMMAND_OUTPUT_CHARS=200000

# Timeout (seconds) for git/misc subprocess calls other than run_command
# (which uses COMMAND_TIMEOUT_MS) and git fetch/pull/push (GIT_NETWORK_TIMEOUT).
SUBPROCESS_TIMEOUT=15

# Include dotfiles/dot-directories by default in list_dir/tree/search results.
ALLOW_HIDDEN_DEFAULT=true

# Hosts allowed in the HTTP Host header (DNS-rebinding protection).
ALLOWED_HOSTS=127.0.0.1:*,localhost:*
ENABLE_DNS_REBINDING_PROTECTION=true

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------

# none   - no authentication at all (fine for 127.0.0.1-only, local testing).
# bearer - requires `Authorization: Bearer <MCP_BEARER_TOKEN>` on every
#          request. Strongly recommended as soon as the /mcp endpoint is
#          reachable from outside your own machine (tunnel, VPS, LAN).
MCP_AUTH_MODE=none

# Required when MCP_AUTH_MODE=bearer. Generate something long and random,
# e.g. `openssl rand -hex 32`.
MCP_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# Misc / advanced (rarely need to change these)
# -----------------------------------------------------------------------------

# Informational namespace hint surfaced to ChatGPT/doctor output. Defaults to
# "/<PROJECT_ROOT folder name>" when left blank; override only if you want a
# different display prefix.
CANONICAL_NAMESPACE=

# Reserved for a future ChatGPT connector feature (ephemeral resource
# handles). No effect today; leave at the default.
EPHEMERAL_HANDLES_SUPPORTED=false
